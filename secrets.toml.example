OPENAI_API_KEY = "sk-..."

# 既存の言いカエルと同じSupabase Projectを使っても構いません。
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
# Supabaseのserver-side Secret / service_role相当をStreamlit Secretsだけに保存してください。
SUPABASE_SECRET_KEY = "YOUR_SERVER_SIDE_SECRET_KEY"

# 家族用。不要なら空文字でも動きますが、写真・日記アプリなので設定を推奨します。
FAMILY_PIN = "1234"
APP_TIMEZONE = "Asia/Tokyo"

TEXT_MODEL = "gpt-5.6-luna"
VISION_MODEL = "gpt-5.6-luna"
TRANSCRIBE_MODEL = "gpt-4o-mini-transcribe"
TTS_MODEL = "gpt-4o-mini-tts"
TTS_VOICE = "coral"
USE_FAST_MODE = "true"

PHOTO_BUCKET = "burari-photos"
